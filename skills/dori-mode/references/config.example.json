{
  "stateDir": "~/.dori/state",
  "laneWorkspace": "lanes",
  "leadWorkspace": "lead",
  "workspaces": [
    "lanes"
  ],
  "ignorePanes": [],
  "leadPane": "",
  "defaultCwd": "~/code/my-project",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "workThresholdSec": 120,
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {},
  "schemaVersion": 2,
  "runtime": {
    "kind": "codex",
    "binary": "codex",
    "requiredVersion": "0.163.0",
    "roles": {
      "lead": {
        "model": "gpt-6-luna",
        "effort": "low"
      },
      "lane": {
        "model": "gpt-6-luna",
        "effort": "low"
      }
    },
    "sandbox": "workspace-write",
    "approvalPolicy": "on-request"
  },
  "ingress": []
}
